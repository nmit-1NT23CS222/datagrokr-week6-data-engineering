USE datagrokr_de_pipeline;

DELIMITER //

CREATE TRIGGER trg_after_sales_insert
AFTER INSERT ON fact_sales
FOR EACH ROW
BEGIN
INSERT INTO sales_audit_log
(sales_id, action_type)
VALUES
(NEW.sales_id, 'INSERT');
END //

DELIMITER ;

-- View the audit log
SELECT *
FROM sales_audit_log
ORDER BY logged_at DESC;
